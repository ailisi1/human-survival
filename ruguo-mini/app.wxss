/* 如果当时 · 全局样式
 *
 * 视觉沿用网页版：深紫黑牌桌 + 金色命运线 + 朱红/青绿区分得失。
 * 尺寸一律 rpx（750rpx = 屏宽），字号在 28~40rpx 之间，微信里读着不累。
 */

page {
  min-height: 100%;
  background: #050010;
  color: #ede6d8;
  font-family: "Songti SC", "Noto Serif SC", "STSong", serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button {
  box-sizing: border-box;
}

/* 顶部紫光晕：网页版那道光，用径向渐变模拟 */
.halo {
  position: fixed;
  top: -420rpx;
  left: 50%;
  width: 1200rpx;
  height: 900rpx;
  margin-left: -600rpx;
  background: radial-gradient(circle at 50% 50%, rgba(126, 74, 208, 0.42) 0%, rgba(5, 0, 16, 0) 68%);
  pointer-events: none;
  z-index: 0;
}

.page-bg {
  position: relative;
  min-height: 100vh;
  padding: 0 40rpx 60rpx;
  z-index: 1;
}

/* ---------- 按钮 ---------- */
.btn-gold {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #f0cf82 0%, #e0b659 100%);
  color: #201603;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(232, 194, 104, 0.24);
}

.btn-gold::after { border: none; }

.btn-ghost {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 22rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.04);
  color: rgba(237, 230, 216, 0.78);
  font-size: 29rpx;
  letter-spacing: 2rpx;
  border: 1rpx solid rgba(232, 194, 104, 0.26);
}

.btn-ghost::after { border: none; }

.btn-ghost[disabled] {
  opacity: 0.42;
  color: rgba(237, 230, 216, 0.5);
}

/* ---------- 分割线 ---------- */
.divider {
  height: 1rpx;
  margin: 40rpx 0;
  background: linear-gradient(90deg, rgba(232, 194, 104, 0) 0%, rgba(232, 194, 104, 0.34) 50%, rgba(232, 194, 104, 0) 100%);
}

/* ---------- 四维数值条 ---------- */
.stats {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.stat {
  flex: 1;
}

.stat-label {
  font-size: 21rpx;
  color: rgba(237, 230, 216, 0.5);
  letter-spacing: 1rpx;
}

.stat-track {
  height: 6rpx;
  margin: 8rpx 0 5rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.09);
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.35s ease;
}

.stat-val {
  font-size: 21rpx;
  color: rgba(237, 230, 216, 0.66);
  font-variant-numeric: tabular-nums;
}

/* ---------- 进度 ---------- */
.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 26rpx;
}

.progress-row .round {
  font-size: 25rpx;
  color: rgba(232, 194, 104, 0.82);
  letter-spacing: 2rpx;
}

.progress-row .age {
  font-size: 23rpx;
  color: rgba(237, 230, 216, 0.45);
}

.track {
  height: 3rpx;
  margin-top: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 2rpx;
  overflow: hidden;
}

.track-fill {
  height: 100%;
  background: rgba(232, 194, 104, 0.62);
  transition: width 0.4s ease;
}

/* ---------- 卡片 ---------- */
.qcard {
  margin-top: 40rpx;
  padding: 46rpx 40rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.038);
  border: 1rpx solid rgba(232, 194, 104, 0.22);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.38);
}

.qcard-chain {
  border-color: rgba(224, 120, 102, 0.42);
  background: rgba(224, 120, 102, 0.05);
}

.qkicker {
  font-size: 22rpx;
  color: rgba(232, 194, 104, 0.66);
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}

.qtitle {
  font-size: 42rpx;
  line-height: 1.42;
  font-weight: 700;
  color: #f2ead9;
  letter-spacing: 1rpx;
}

.qbody {
  margin-top: 26rpx;
  font-size: 28rpx;
  line-height: 1.86;
  color: rgba(237, 230, 216, 0.72);
  text-align: justify;
}

/* ---------- 选项 ---------- */
.opts {
  margin-top: 34rpx;
}

.opt {
  position: relative;
  padding: 32rpx 30rpx;
  margin-bottom: 22rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: border-color 0.2s, background 0.2s;
}

.opt-gain {
  border-left: 4rpx solid #7dd9a6;
}

.opt-lose {
  border-left: 4rpx solid #e07866;
}

.opt:active {
  background: rgba(232, 194, 104, 0.1);
  border-color: rgba(232, 194, 104, 0.5);
}

.opt-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.opt-tag {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 4rpx;
  font-size: 21rpx;
  background: rgba(232, 194, 104, 0.18);
  color: #e8c268;
}

.opt-gain-label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(125, 217, 166, 0.86);
}

.opt-lose .opt-gain-label {
  color: rgba(224, 120, 102, 0.9);
}

.opt-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #f0e8d6;
  line-height: 1.5;
}

.opt-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.72;
  color: rgba(237, 230, 216, 0.6);
}

/* 剧情 / 事件用的简单选项 */
.beat-opt {
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.beat-opt:active {
  background: rgba(232, 194, 104, 0.1);
  border-color: rgba(232, 194, 104, 0.5);
}

/* ---------- 多选 ---------- */
.multi-hint {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: rgba(237, 230, 216, 0.5);
  letter-spacing: 1rpx;
}

.multi-hint .num {
  color: #e8c268;
  font-size: 30rpx;
}

.multi-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 26rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
}

.multi-item.selected {
  background: rgba(232, 194, 104, 0.1);
  border-color: rgba(232, 194, 104, 0.52);
}

.multi-check {
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  flex-shrink: 0;
}

.multi-item.selected .multi-check {
  border-color: #e8c268;
  background: #e8c268;
  box-shadow: inset 0 0 0 6rpx #14101f;
}

.multi-body {
  flex: 1;
}

.multi-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #f0e8d6;
}

.multi-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.66;
  color: rgba(237, 230, 216, 0.55);
}

.multi-tag {
  font-size: 20rpx;
  color: rgba(232, 194, 104, 0.72);
  letter-spacing: 1rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.multi-confirm {
  margin-top: 34rpx;
}

/* ---------- 通用留白 ---------- */
.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
