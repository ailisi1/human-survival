/* 结算页 */

.end {
  padding-top: 46rpx;
  text-align: center;
}

.end-label {
  font-size: 24rpx;
  letter-spacing: 5rpx;
  color: rgba(237, 230, 216, 0.46);
}

.unlock {
  display: inline-block;
  margin-top: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #e8c268;
  background: rgba(232, 194, 104, 0.1);
  border: 1rpx solid rgba(232, 194, 104, 0.32);
}

.end-title {
  margin-top: 34rpx;
  font-size: 62rpx;
  line-height: 1.34;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #e8c268;
}

.end-sub {
  margin-top: 26rpx;
  padding: 0 10rpx;
  font-size: 26rpx;
  line-height: 1.86;
  color: rgba(237, 230, 216, 0.6);
  text-align: center;
}

/* 四维两列 */
.end-stats {
  display: flex;
  flex-wrap: wrap;
}

.end-stat {
  width: 50%;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 14rpx 12rpx;
}

.end-stat-label {
  font-size: 25rpx;
  color: rgba(237, 230, 216, 0.5);
}

.end-stat-val {
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}

/* 放弃清单 */
.regret-card {
  padding: 38rpx 34rpx 30rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.032);
  border: 1rpx solid rgba(224, 120, 102, 0.24);
  text-align: left;
}

.regret-title {
  font-size: 27rpx;
  letter-spacing: 3rpx;
  color: rgba(224, 120, 102, 0.92);
  margin-bottom: 22rpx;
}

.regret-item {
  position: relative;
  padding-left: 26rpx;
  margin-bottom: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: rgba(237, 230, 216, 0.76);
}

.regret-item::before {
  content: "·";
  position: absolute;
  left: 6rpx;
  color: rgba(224, 120, 102, 0.7);
}

.regret-tag {
  margin-top: 18rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: rgba(237, 230, 216, 0.34);
}

/* 人生码 */
.code-box {
  margin-top: 34rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  border: 1rpx dashed rgba(232, 194, 104, 0.3);
  background: rgba(232, 194, 104, 0.04);
}

.code-label {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(237, 230, 216, 0.42);
}

.code-val {
  display: block;
  margin: 12rpx 0 10rpx;
  font-size: 42rpx;
  letter-spacing: 8rpx;
  color: #e8c268;
  font-variant-numeric: tabular-nums;
}

.code-hint {
  font-size: 21rpx;
  color: rgba(237, 230, 216, 0.34);
}

.end-actions {
  margin-top: 46rpx;
}
