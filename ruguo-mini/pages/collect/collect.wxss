/* 收藏页 */

.collect {
  padding-top: 40rpx;
  text-align: center;
}

.col-label {
  font-size: 23rpx;
  letter-spacing: 5rpx;
  color: rgba(237, 230, 216, 0.42);
}

.col-title {
  margin-top: 18rpx;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #f2ead9;
}

.col-sub {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(237, 230, 216, 0.5);
}

.col-bar {
  height: 4rpx;
  margin-top: 34rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.col-fill {
  height: 100%;
  background: linear-gradient(90deg, rgba(232, 194, 104, 0.55) 0%, #e8c268 100%);
  transition: width 0.5s ease;
}

.col-count {
  margin-top: 14rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(237, 230, 216, 0.4);
}

/* 页签 */
.tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 34rpx;
}

.tab {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 6rpx;
  font-size: 25rpx;
  color: rgba(237, 230, 216, 0.52);
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tab.on {
  color: #e8c268;
  border-color: rgba(232, 194, 104, 0.45);
  background: rgba(232, 194, 104, 0.08);
}

.tab-n {
  font-size: 21rpx;
  margin-left: 8rpx;
  opacity: 0.7;
}

/* 图鉴网格：两列 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 30rpx;
}

.cell {
  width: calc(50% - 9rpx);
  min-height: 178rpx;
  padding: 24rpx 22rpx;
  border-radius: 8rpx;
  text-align: left;
}

.cell-got {
  background: rgba(232, 194, 104, 0.07);
  border: 1rpx solid rgba(232, 194, 104, 0.34);
}

.cell-lock {
  background: rgba(255, 255, 255, 0.022);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.cell-num {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(237, 230, 216, 0.28);
  font-variant-numeric: tabular-nums;
}

.cell-name {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #f0e6d0;
}

.cell-name.lock {
  color: rgba(237, 230, 216, 0.24);
  font-size: 34rpx;
}

.cell-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: rgba(237, 230, 216, 0.34);
}

.cell-got .cell-hint {
  color: rgba(232, 194, 104, 0.6);
  letter-spacing: 2rpx;
}

.col-empty {
  margin-top: 40rpx;
  font-size: 25rpx;
  color: rgba(237, 230, 216, 0.4);
}

.col-actions {
  margin-top: 46rpx;
}
